---
import BaseLayout from '../layouts/BaseLayout.astro';
import { apps } from '../data/apps';

const getDownloadValue = (downloads: string) => {
  const normalizedDownloads = downloads.trim().toUpperCase().replace('+', '');
  const multiplier = normalizedDownloads.endsWith('K')
    ? 1_000
    : normalizedDownloads.endsWith('M')
      ? 1_000_000
      : 1;
  return Number.parseFloat(normalizedDownloads.replace(/[KM]/g, '')) * multiplier;
};

const homepageApps = [...apps].sort((firstApp, secondApp) => {
  return getDownloadValue(secondApp.downloads) - getDownloadValue(firstApp.downloads);
});

const formatDownloadValue = (downloads: number) => {
  if (downloads >= 1_000_000) return `${Math.floor(downloads / 1_000_000)}M+`;
  if (downloads >= 1_000) return `${Math.floor(downloads / 1_000)}K+`;
  return `${downloads}+`;
};

const totalDownloads = formatDownloadValue(
  homepageApps.reduce((total, app) => total + getDownloadValue(app.downloads), 0)
);

const featuredShots = homepageApps.map((app) => app.screenshots[0]).filter(Boolean);
---

<BaseLayout
  title="Restart Apps | Practical mobile apps"
  description="Restart Apps builds practical mobile apps for job search, space tracking, travel, and everyday tools."
>
  <main class="main">
    <section class="hero">
      <div class="hero-content" data-reveal>
        <h1 class="headline">Restart Apps</h1>
        <p class="hero-copy" data-reveal>
          We create high-quality, user-friendly mobile apps for focused everyday tasks. From
          finding federal jobs to tracking the International Space Station, each app is designed to
          feel clear, useful, and easy to come back to.
        </p>
        <div class="hero-metrics" data-reveal>
          <div class="metric">
            <strong>{totalDownloads}</strong>
            <span>Total downloads</span>
          </div>
          <div class="metric">
            <strong>{homepageApps.length}</strong>
            <span>Mobile apps</span>
          </div>
        </div>
        <div class="hero-actions" data-reveal>
          <a class="button primary" href="#apps">View apps</a>
          <a class="button secondary" href="/support">Get support</a>
        </div>
      </div>

      <div class="showcase" aria-label="App screenshots">
        <span class="motion-ribbon ribbon-a" aria-hidden="true"></span>
        <span class="motion-ribbon ribbon-b" aria-hidden="true"></span>
        <span class="signal-line line-a" aria-hidden="true"></span>
        <span class="signal-line line-b" aria-hidden="true"></span>
        <div class="phone-stack">
          {
            featuredShots.map((shot, index) => (
              <div class={`phone-shot ${['first', 'second', 'third'][index]}`}>
                <img src={shot} alt="" loading={index === 0 ? 'eager' : 'lazy'} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="apps">
      <div class="section-header" data-reveal>
        <h2>Apps</h2>
      </div>

      <div class="app-grid">
        {
          homepageApps.map((app, index) => (
            <a class="app-card" href={`/apps/${app.slug}`} data-reveal style={`--reveal-delay: ${index * 90}ms`}>
              <img class="app-icon" src={app.icon} alt={`${app.name} icon`} loading="lazy" />
              <div>
                <p class="eyebrow">{app.eyebrow}</p>
                <h3>{app.name}</h3>
                <p>{app.shortDescription}</p>
                <div class="app-stat" aria-label={`${app.name} public store downloads`}>
                  <strong>{app.downloads}</strong>
                  <span>Downloads</span>
                </div>
                <div class="pill-row" aria-label={`${app.name} features`}>
                  {app.highlights.map((highlight) => (
                    <span class="pill">{highlight}</span>
                  ))}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

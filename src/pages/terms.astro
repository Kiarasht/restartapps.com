---
import BaseLayout from '../layouts/BaseLayout.astro';

const contactEmail = 'restartapplication@gmail.com';
const effectiveDate = 'May 8, 2026';
---

<BaseLayout title="Terms of Use | Restart Apps" description="Website terms of use for restartapps.com.">
  <main class="main">
    <section class="section legal-page">
      <div class="section-header" data-reveal>
        <p class="eyebrow">Restart Apps</p>
        <h1>Terms of Use</h1>
        <p class="legal-updated">Effective date: {effectiveDate}</p>
      </div>

      <div class="legal-content">
        <section class="legal-block" data-reveal>
          <h2>Agreement</h2>
          <p>
            These Terms of Use govern your access to and use of restartapps.com (the "Website").
            By using the Website, you agree to these Terms.
          </p>
          <p>
            Mobile apps listed on the Website may have their own app-specific terms, privacy
            policies, store listings, and platform rules.
          </p>
        </section>

        <section class="legal-block" data-reveal>
          <h2>Purpose of the Website</h2>
          <p>
            The Website provides information about Restart Apps projects, including app
            descriptions, screenshots, store links, support information, privacy policies, and terms.
          </p>
          <p>
            Content on the Website is provided for general informational and support purposes only.
          </p>
        </section>

        <section class="legal-block" data-reveal>
          <h2>Acceptable Use</h2>
          <p>
            You agree not to misuse the Website, interfere with its normal operation, attempt
            unauthorized access, introduce harmful code, scrape or copy the Website in a way that
            burdens the service, or use the Website for unlawful purposes.
          </p>
        </section>

        <section class="legal-block" data-reveal>
          <h2>App Information</h2>
          <p>
            App descriptions, screenshots, availability, download counts, features, and links may
            change over time. We try to keep information accurate, but we do not guarantee that all
            Website content is complete, current, or error-free.
          </p>
          <p>
            Store listings, app downloads, purchases, ratings, reviews, and platform features are
            provided by third-party app stores and may be subject to their own terms.
          </p>
        </section>

        <section class="legal-block" data-reveal>
          <h2>Third-Party Services and Links</h2>
          <p>
            The Website may link to Google Play, app stores, official data sources, support tools,
            and other third-party websites. We do not control those third-party services and are not
            responsible for their content, policies, availability, security, or practices.
          </p>
        </section>

        <section class="legal-block" data-reveal>
          <h2>No Affiliation</h2>
          <p>
            Restart Apps is an independent app publisher. Unless clearly stated otherwise, our apps
            and Website are not affiliated with, endorsed by, or operated by government agencies,
            NASA, the International Space Station program, the U.S. General Services
            Administration, USAJOBS, the U.S. Office of Personnel Management, Google, or any app
            store provider.
          </p>
        </section>

        <section class="legal-block" data-reveal>
          <h2>Intellectual Property</h2>
          <p>
            The Website's design, text, branding, and original materials are owned by Restart Apps
            or used with permission and are protected by applicable intellectual property laws.
            Third-party names, logos, trademarks, screenshots, public data, and store badges remain
            the property of their respective owners.
          </p>
        </section>

        <section class="legal-block" data-reveal>
          <h2>Disclaimer</h2>
          <p>
            The Website is provided on an "as is" and "as available" basis without warranties of
            any kind, express or implied, including warranties of accuracy, availability,
            merchantability, fitness for a particular purpose, and non-infringement.
          </p>
        </section>

        <section class="legal-block" data-reveal>
          <h2>Limitation of Liability</h2>
          <p>
            To the fullest extent permitted by law, Restart Apps is not liable for any indirect,
            incidental, special, consequential, exemplary, or punitive damages, or for any loss of
            data, profits, opportunities, or goodwill arising from your use of the Website.
          </p>
        </section>

        <section class="legal-block" data-reveal>
          <h2>Changes and Contact</h2>
          <p>
            We may revise these Terms from time to time. When we do, we will update the effective
            date above. Your continued use of the Website after changes become effective means you
            accept the updated Terms.
          </p>
          <p>
            If you have questions about these Terms, contact us at
            <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
          </p>
        </section>
      </div>
    </section>
  </main>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { apps } from '../../../data/apps';

export function getStaticPaths() {
  return apps
    .filter((app) => app.slug === 'pgnify')
    .map((app) => ({
      params: { slug: app.slug },
      props: { app }
    }));
}

const app = Astro.props.app;
const supportEmail = 'restartapplication@gmail.com';
const supportHref = `mailto:${supportEmail}?subject=Pgnify%20support`;
---

<BaseLayout title={`${app.name} Support | Restart Apps`} description={`Support for ${app.name}.`}>
  <main class="main">
    <section class="section legal-page">
      <div class="section-header page-hero hero-surface" data-reveal>
        <p class="eyebrow">{app.name}</p>
        <h1>Support</h1>
        <p>
          For help with Pgnify, email us with your device model (iPhone, iPad, or Android device), its
          system version, and a short description of what happened. Please do not include passwords or sensitive information.
        </p>
        <p class="contact-email">
          <a href={supportHref}>{supportEmail}</a>
        </p>
        <div class="hero-actions">
          <a class="button primary" href={supportHref}>Email support</a>
        </div>
      </div>

      <div class="legal-content">
        <section class="legal-block" data-reveal>
          <h2>Game imports and analysis</h2>
          <p>
            Include whether the game came from a public Chess.com username, pasted PGN, or a PGN
            file. A screenshot and the step where analysis stopped are useful, but do not send a
            Chess.com password because Pgnify never needs one.
          </p>
        </section>

        <section class="legal-block" data-reveal>
          <h2>Practice and progress</h2>
          <p>
            Practice positions and the accuracy and weakness summaries on Home come from your own
            games whose review you have unlocked at least once. If they are missing, analyze one of
            your games and open its review. Practice answers come from each game's saved analysis; a
            move the engine rates within 0.3 pawns of its first choice also counts.
          </p>
        </section>

        <section class="legal-block" data-reveal>
          <h2>Privacy choices</h2>
          <p>
            If a game review does not open, include your region, whether a privacy message appeared,
            and what the App showed. Where Google requires it, advertising privacy choices can be
            revisited in Pgnify Settings. Usage analytics and crash reports can be turned off at any
            time in Settings.
          </p>
        </section>

        <section class="legal-block" data-reveal>
          <h2>Local data</h2>
          <p>
            Pgnify has no app account or cloud sync. Removing the App or clearing its data removes
            locally saved games, reviews, favorites, settings, and earned unlock receipts. Restart
            Apps cannot restore local data from a server.
          </p>
        </section>

        <section class="legal-block" data-reveal>
          <h2>Policies</h2>
          <p>
            Review the <a href={`/apps/${app.slug}/privacy`}>Pgnify Privacy Policy</a> and
            <a href={`/apps/${app.slug}/terms`}>Pgnify Terms of Use</a>.
          </p>
        </section>
      </div>
    </section>
  </main>
</BaseLayout>

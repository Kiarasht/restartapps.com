---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MovePath from '../../components/MovePath.astro';
import { apps, getAvailability } from '../../data/apps';

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { slug: app.slug },
    props: { app }
  }));
}

const app = Astro.props.app;
const availability = getAvailability(app);
---

<BaseLayout title={`${app.name} | Restart Apps`} description={app.shortDescription}>
  <main class="main">
    <section class="detail-hero hero-surface">
      <MovePath />
      <div data-reveal>
        <div class="detail-title-row">
          <img class="app-icon" src={app.icon} alt={`${app.name} icon`} />
          <div>
            <p class="eyebrow">{app.eyebrow}</p>
            <h1 class="headline">{app.name}</h1>
          </div>
        </div>
        <p class="detail-copy" data-reveal>{app.description}</p>
        <div class="pill-row" aria-label={`${app.name} platforms`} data-reveal>
          {app.platforms.map((platform) => <span class="pill">{platform}</span>)}
        </div>
        <div class="hero-metrics" data-reveal>
          <div class={`metric is-${availability.tone}`}>
            <strong>{availability.value}</strong>
            <span>{availability.label}</span>
          </div>
        </div>
        {
          app.links.length > 0 && (
            <div class="hero-actions" data-reveal>
              {app.links.map((link) => <a class="button primary" href={link.href}>{link.label}</a>)}
            </div>
          )
        }
      </div>

      <div class="screenshot-row" aria-label={`${app.name} screenshots`}>
        {
          app.screenshots.map((screenshot, index) => (
            <div class="screenshot-frame" data-reveal style={`--reveal-delay: ${index * 100}ms`}>
              <img src={screenshot} alt={`${app.name} screenshot ${index + 1}`} loading="lazy" />
            </div>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section-header" data-reveal>
        <p class="eyebrow">{app.status}</p>
        <h2>Built for the task</h2>
      </div>
      <ul class="feature-list">
        {
          app.detailHighlights.map((highlight, index) => (
            <li data-reveal style={`--reveal-delay: ${index * 90}ms`}>{highlight}</li>
          ))
        }
      </ul>
    </section>

    <section class="section">
      <div class="section-header" data-reveal>
        <p class="eyebrow">Legal</p>
        <h2>{app.name} policies</h2>
      </div>
      <div class="legal-link-row" data-reveal>
        <a class="button secondary" href={`/apps/${app.slug}/privacy`}>Privacy Policy</a>
        <a class="button secondary" href={`/apps/${app.slug}/terms`}>Terms of Use</a>
      </div>
    </section>
  </main>
</BaseLayout>

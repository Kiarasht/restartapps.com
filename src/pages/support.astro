---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Support | Restart Apps" description="Get support for Restart Apps mobile apps.">
  <main class="main">
    <section class="section">
      <div class="section-header" data-reveal>
        <p class="eyebrow">Support</p>
        <h2>Help with Restart Apps</h2>
        <p>
          Email support and include the app name, your device model, Android version, and a short
          description of what happened.
        </p>
        <div class="hero-actions" data-reveal>
          <a class="button primary" href="mailto:restartapplication@gmail.com?subject=Restart%20Apps%20support">
            Email support
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

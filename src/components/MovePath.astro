---
// The gold-to-violet-to-teal curve that runs through Pgnify's store screenshots. Decorative.
---

<svg class="move-path" viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true">
  <defs>
    <linearGradient id="move-path-gradient" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#FFD36B" />
      <stop offset="0.55" stop-color="#C4B5FD" />
      <stop offset="1" stop-color="#2DD4BF" />
    </linearGradient>
  </defs>
  <path vector-effect="non-scaling-stroke" d="M-20 585 C 220 560, 400 470, 580 500 S 840 420, 1020 210" />
</svg>
